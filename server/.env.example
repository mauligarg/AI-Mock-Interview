# ── Server Port & Host ─────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── MongoDB Connection String ──────────────────────────────────
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/ai-interview-db

# ── Authentication Security ────────────────────────────────────
JWT_SECRET=replace_with_a_strong_random_jwt_secret_key
JWT_EXPIRES_IN=7d

# ── Groq AI Engine Key & Model ─────────────────────────────────
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ── Initial Bootstrap Administrator Account ─────────────────────
BOOTSTRAP_ADMIN_NAME=Platform Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=SecureAdminPassword123!

# ── Email Service (Nodemailer / SMTP) ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="AI Interview Platform" <no-reply@aiinterview.com>

# ── CORS & Client Origin URL ───────────────────────────────────
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
DEV_SHOW_AUTH_LINKS=false
